# =============================================================================
# SUMA — Variables de Entorno del Frontend (Next.js)
# Copia este archivo como '.env.local' y completa los valores.
# =============================================================================

# --- API Backend ---
# URL del backend (cambia según el entorno).
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# --- Firebase (Client SDK) ---
# Estas son las credenciales PÚBLICAS del proyecto Firebase.
# Se obtienen desde: Firebase Console → Configuración del proyecto → SDK Web.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tu-proyecto
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=tu-proyecto.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
