# SUMA — Variables de Entorno (Backend)
# Copiar a .env y completar con valores reales

# Entorno
NODE_ENV=development
PORT=3001

# Base de Datos (PostgreSQL via Cloud SQL)
DB_USER=suma_user
DB_PASSWORD=tu_password_seguro
DB_NAME=suma_db
DB_HOST=127.0.0.1
DB_PORT=5432

# Cloud SQL (producción en Cloud Run)
# DB_CLOUD_SQL_CONNECTION_NAME=proyecto:region:instancia

# Límite del pool de conexiones
DB_POOL_MAX=10

# CORS
CORS_ORIGENES_PERMITIDOS=http://localhost:3000,http://localhost:3001

# Firebase Admin SDK (JSON inline o path a archivo)
# FIREBASE_PROJECT_ID=tu-proyecto
# GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json