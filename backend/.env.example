# =============================================================================
# SUMA — Variables de Entorno del Backend
# Copia este archivo como '.env' y completa los valores.
# =============================================================================

# --- Servidor ---
# Puerto en el que escucha Express. Cloud Run inyecta $PORT automáticamente.
PORT=3001
NODE_ENV=development

# --- PostgreSQL (Cloud SQL) ---
# En desarrollo local, usa TCP directo.
# En Cloud Run, usa el socket Unix: /cloudsql/PROYECTO:REGION:INSTANCIA
DB_HOST=localhost
DB_PORT=5432
DB_NAME=suma_db
DB_USER=suma
DB_PASSWORD=suma_dev_password
# Solo para Cloud Run (dejar vacío en local):
DB_CLOUD_SQL_CONNECTION_NAME=

# --- Firebase Admin SDK ---
# En GCP, las credenciales se resuelven automáticamente via Application Default Credentials.
# En desarrollo local, apuntar al archivo JSON de la cuenta de servicio:
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json
FIREBASE_PROJECT_ID=tu-proyecto-firebase

# --- CORS ---
# Orígenes permitidos para el frontend (separados por coma).
CORS_ORIGENES_PERMITIDOS=http://localhost:3000

# --- Seguridad ---
# Clave AES-256 para encriptar credenciales de pasarelas de pago.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CLAVE_ENCRIPTACION_PASARELAS=
